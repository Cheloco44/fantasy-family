---
import '../styles/global.css';
import data from '../data/clubhouse.json';
const { title = 'Clubhouse', active = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [['home', '', 'Clubhouse'], ['managers', 'managers/', 'Managers'], ['recaps', 'recaps/', 'Recaps'], ['memes', 'memes/', 'Meme locker']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Redlands Possum Busters fantasy hockey clubhouse. Public family clubhouse. Profiles are owner-supplied; results are not yet connected."/><title>{title} · Redlands Possum Busters</title></head><body>
<a class="skip" href="#main">Skip to content</a>
<div class="topline"><div class="container topline-inner"><span>FAMILY FANTASY HOCKEY / {data.season}</span><span>ARIZONA TIME · 05:00 RECAP TARGET</span></div></div>
<header class="container masthead"><a class="brand" href={base} aria-label="Redlands Possum Busters home"><span class="crest" aria-hidden="true">RPB<span>✦</span></span><span>REDLANDS<small>POSSUM BUSTERS</small></span></a><div class="header-note">Good hockey.<br/><strong>Questionable management.</strong></div></header>
<div class="nav-shell"><nav class="container" aria-label="Main navigation">{nav.map(([key,path,label])=><a href={`${base}${path}`} aria-current={active===key?'page':undefined}>{label}</a>)}<span class="nav-status"><i></i> CLUBHOUSE</span></nav></div>
<div class="container demo-banner"><strong>DEMO DATA</strong><span>Profiles are owner-supplied. Scoreboard and recaps are samples or unavailable—not verified live results.</span></div>
<main id="main" class="container"><slot/></main>
<footer class="container"><div><strong>REDLANDS POSSUM BUSTERS</strong><p>Keep the chirps on the ice. Leave the spouses out of it.</p></div><div><span>{data.season} · America/Phoenix</span><p>Family clubhouse · No tracking</p></div></footer>
</body></html>
