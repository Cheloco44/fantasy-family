---
import snapshot from '../data/current.json';
const connected = snapshot.mode === 'live';
const fetched = connected && snapshot.fetchedAt ? new Date(snapshot.fetchedAt).toLocaleString('en-US',{timeZone:'America/Phoenix',dateStyle:'medium',timeStyle:'short'}) : null;
---
<section class="status" aria-labelledby="status-heading" data-snapshot-mode={snapshot.mode} data-snapshot-time={snapshot.fetchedAt || ''}>
  <h2 id="status-heading" class="sr-only">Update status</h2>
  <span class="small" data-freshness-label aria-live="polite">{connected ? 'ESPN snapshot' : 'Not connected'}</span>
  <p class="small muted">{fetched ? `Last successful results fetch: ${fetched} Arizona time` : 'No successful ESPN results refresh'}</p>
  <p class="small" data-stale-message>{connected ? 'Timestamped snapshot, not a real-time feed. Check the collection time.' : 'Live results are unavailable. No scores have been inferred from sample content.'}</p>
  <details class="publication-note"><summary>Data details</summary>
  <dl><dt>Scoring format</dt><dd>{connected ? (snapshot.scoringType === 'H2H_CATEGORY' ? 'Head-to-head categories' : 'Head-to-head points') : 'Awaiting validated settings'}</dd><dt>Daily recap target</dt><dd>07:00 · America/Phoenix · Best-effort scheduled publication</dd><dt>Daily recap content</dt><dd>Provider daily aggregates + fictional banter. Not historical player/bench analysis.</dd><dt>Image review</dt><dd>Approved images only. No reply means approved older art or character portraits.</dd></dl>
  <p class="small divider">Standings and matchup totals are separate from yesterday's daily round. Storylines are never scoring evidence. Scheduled runs may be delayed.</p>
  <a class="btn" href="https://github.com/Cheloco44/fantasy-family/actions/workflows/daily-clubhouse.yml" target="_blank" rel="noopener noreferrer">Admin: daily refresh and publish ↗</a>
  <p class="small muted" style="margin-top:12px">A failed collection preserves the last successful edition. Check its date before sharing.</p>
  </details>
</section>
<script>
import { freshness } from '../lib/current-data.mjs';
const panel=document.querySelector<HTMLElement>('[data-snapshot-mode]');
function updateFreshness(){
 if(!panel)return;
 const state=freshness({mode:panel.dataset.snapshotMode,fetchedAt:panel.dataset.snapshotTime});
 const label=panel.querySelector('[data-freshness-label]');
 const message=panel.querySelector('[data-stale-message]');
 if(label)label.textContent=state==='unavailable'?'Not connected':state==='stale'?'Stale ESPN snapshot':'ESPN snapshot';
 const compact=document.querySelector('[data-compact-freshness]');
 if(compact)compact.textContent=state==='stale'?'STALE: this snapshot is at least 24 hours old. Scores may have changed.':state==='current'?'Timestamped ESPN snapshot—not a real-time feed.':'No verified results snapshot yet.';
 if(message)message.textContent=state==='unavailable'?'Results are unavailable; no scores are inferred.':state==='stale'?'Warning: scores are at least 24 hours old. Showing the last successful update.':'Timestamped scores—not a live feed.';
}
updateFreshness();setInterval(updateFreshness,60000);
window.addEventListener('pageshow',updateFreshness);
</script>
