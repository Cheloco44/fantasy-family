---
import Layout from '../../layouts/Layout.astro';
import recaps from '../../data/recaps.json';
const base = import.meta.env.BASE_URL;
const stamp = value => new Intl.DateTimeFormat('en-US', { timeZone: 'America/Phoenix', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
---
<Layout title="Recap archive" active="recaps">
  <div class="eyebrow">THE MORNING SKATE</div><h1>Yesterday's hockey.<br/>Today's receipts.</h1>
  <p class="muted">Daily rounds by Arizona calendar date. Target publication: <strong>07:00 America/Phoenix</strong> the following morning. Scheduling is best-effort, not an exact-time guarantee.</p>
  {recaps.editions.length === 0 && <p>No daily editions are available. The sample below is not actual league performance.</p>}
  <div class="recap-list">{recaps.editions.map((edition, i) => <article class="recap-entry" data-recap-date={i === 0 ? edition.date : undefined}>
    <div class="eyebrow"><time datetime={edition.date}>{edition.date}</time> · {edition.status === 'verified-aggregate' ? 'VERIFIED TEAM AGGREGATES' : edition.status === 'off-day' ? 'OFF-DAY' : 'INCOMPLETE'}</div>
    <h2><a href={`${base}recaps/${edition.date}/`}>{edition.headline}</a></h2><p>{edition.dek}</p>
    <p class="small muted">Fetched <time datetime={edition.sourceFetchedAt}>{stamp(edition.sourceFetchedAt)} AZ</time> · DAILY ROUND, not final weekly W–L.</p>
    {i === 0 && <p class="freshness-warning" data-recap-stale hidden role="status">The latest edition is older than yesterday in Arizona. Publication may be delayed or a refresh may have failed. Last successful data is preserved.</p>}
  </article>)}</div>
  <section class="publication-note"><h2>What the receipts prove</h2><p>Daily team-point aggregates, not player contributions, active/bench assignments or goalie decisions. Weekly snapshots appear separately with their actual timestamp; they are not reconstructed end-of-day standings.</p><p>Close and smoked classifications use transparent daily-margin thresholds: ≤5 points is close; ≥20 is smoked. Seven-calendar-day trend notes count only recorded, verified daily rounds. Missing dates and off-days do not prove an unbroken streak or an official ESPN record.</p><p>New images require owner approval. Without a new approved image, the round uses existing approved evergreen artwork or a portrait. No AI scene-generation service is configured. Failed updates leave the last successful edition intact; the browser checks its age without contacting ESPN.</p></section>
  <a class="recap-entry sample-entry" href={`${base}recaps/sample/`}><span class="eyebrow">UNDATED SAMPLE / DEMO DATA</span><h2>The bench would like a word.</h2><span class="muted">Style preview only. No actual league performance implied. →</span></a>
</Layout>
