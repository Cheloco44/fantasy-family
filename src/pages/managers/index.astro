---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/clubhouse.json';
const base = import.meta.env.BASE_URL;
---
<Layout title="Managers" active="managers">
  <div class="eyebrow">THE FRONT OFFICE</div>
  <h1>Eight managers.<br/>Plenty of material.</h1>
  <p class="muted">Big personalities. Questionable lineup decisions. Profiles and storylines supplied by the league owner. The character lore is exaggerated banter, not factual biography or real allegations.</p>
  <div class="two-col">
    {data.managers.map(m => <article class="profile-card">
      <img class="profile-portrait" src={`${base}${m.image}`} alt={`${m.alias} — owner-labeled portrait`} width="400" height="400" loading="lazy" />
      <span class="eyebrow">FICTIONAL LEAGUE LORE</span>
      <h2>{m.alias}</h2>
      <p><strong>{m.team}</strong></p>
      <h3>{m.loreTitle}</h3>
      <p class="muted">{m.loreText}</p>
      <a class="btn" href={`${base}managers/${m.slug}/`}>View profile →</a>
    </article>)}
  </div>
</Layout>
