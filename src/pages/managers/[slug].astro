---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/clubhouse.json';
export function getStaticPaths() {
  return data.managers.map(manager => ({ params: { slug: manager.slug }, props: { manager } }));
}
const { manager: m } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Layout title={m.alias} active="managers">
  <article class="profile-detail">
    <a href={`${base}managers/`} class="small">← All managers</a>
    <img class="detail-portrait" src={`${base}${m.image}`} alt={`${m.alias} — owner-labeled portrait`} width="400" height="400" />
    <div class="eyebrow">THE FRONT OFFICE / OWNER-SUPPLIED PROFILE</div>
    <h1>{m.alias}</h1>
    <h2>{m.team}</h2>
    <section aria-label="Fictional league lore">
      <div class="eyebrow">FICTIONAL LEAGUE LORE</div>
      <h3>{m.loreTitle}</h3>
      <p class="small muted">Owner-supplied storylines and exaggerated banter—not factual biography, real allegations, or quotes attributed to the managers.</p>
      <p>{m.loreText}</p>
    </section>
    <dl class="definition">
      <dt>Favorite NHL team</dt><dd>{m.favoriteTeam || 'Not supplied.'}</dd>
      <dt>Self-written biography</dt><dd>{m.bio || 'Not supplied. The manager writes this one.'}</dd>
      <dt>Championships, rivalries & moments</dt><dd>Not supplied. No imaginary trophy cabinet.</dd>
      <dt>Scouting report</dt><dd>{m.scoutingReport || 'No manager-approved scouting report yet.'}</dd>
    </dl>
    <p class="muted">Profile names and portraits are supplied and labeled by the league owner. Actual player stats and lineup results will appear only after the league-data integration is verified.</p>
  </article>
</Layout>
