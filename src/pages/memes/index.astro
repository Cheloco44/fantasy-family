---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/clubhouse.json';
import editorial from '../../data/editorial.json';
import { existsSync } from 'node:fs';
const base = import.meta.env.BASE_URL;
const validAsset = image => /^(memes|avatars)\/[a-zA-Z0-9_./-]+\.(webp|png|jpg|svg)$/.test(image) && !image.includes('..') && existsSync(`public/${image}`);
const approved = editorial.approvedMemes.filter(m => m.approvalStatus === 'approved' && validAsset(m.image));
const memes = [...approved.map(m => ({ ...m, demo: false })), ...data.memes.filter(m => validAsset(m.image)).map(m => ({ ...m, managers: [], demo: true }))];
const tags = [...new Set(memes.flatMap(m => m.tags))].sort();
const cast = Object.values(editorial.cast);
const spotlight = approved[0];
---
<Layout title="Meme locker" active="memes">
  <div class="eyebrow">THE RECEIPTS DEPARTMENT</div><h1>The meme locker.</h1>
  <p class="muted">Approved rivalry artwork, with the punchline attached. Dated images keep their original Arizona round date; generic demo originals stay unassigned.</p>
  {spotlight && <section class="locker-spotlight" aria-labelledby="spotlight-title"><img src={`${base}${spotlight.image}`} alt={spotlight.caption} width="780" height="600"/><div><span class="pill">LOCKER SPOTLIGHT · OWNER APPROVED</span><h2 id="spotlight-title">{spotlight.caption}</h2><p>From <time datetime={spotlight.date}>{spotlight.date}</time> · {spotlight.contextType === 'dated' ? 'Dated rivalry artwork' : 'Evergreen artwork'}</p><a href={`${base}recaps/`}>Find the daily-round receipts →</a></div></section>}
  <div class="filters"><label>Search captions<input id="meme-search" type="search" placeholder="Find a punchline…" /></label><label>Tag<select id="tag-filter"><option value="">All tags</option>{tags.map(t => <option value={t}>{t}</option>)}</select></label><fieldset id="manager-filter"><legend>Managers <span class="small">(match any selected)</span></legend><div class="manager-options">{cast.map(m => <label><input type="checkbox" name="manager" value={m.slug}/>{m.displayName}</label>)}</div></fieldset><button class="btn" id="clear-filters" type="button">Reset</button></div>
  <p id="results" class="small muted" aria-live="polite">Showing {memes.length} of {memes.length} memes</p>
  <div class="gallery">{memes.map((m, i) => <figure class="meme" data-caption={m.caption.toLowerCase()} data-tags={JSON.stringify(m.tags)} data-managers={JSON.stringify(m.managers)}><img src={`${base}${m.image}`} alt={m.caption} width="780" height="600" loading="lazy"/><figcaption><span class="eyebrow">{m.demo ? 'DEMO ARTWORK · UNASSIGNED' : 'OWNER-APPROVED ARTWORK'}</span>{!m.demo && <span class="pill meme-ref">{m.ref ?? `#${String(i + 1).padStart(2, '0')}`} · {m.pairingLabel ?? Object.values(cast).find(c => c.slug === m.managers[0])?.displayName}</span>}<h2>{m.caption}</h2><p class="small muted"><time datetime={m.date}>{m.date}</time> · {m.demo ? 'Generic original; no actual result implied' : m.contextType === 'dated' ? 'Archived daily-round illustration' : 'Evergreen rivalry illustration'}</p>{!m.demo && <p class="small">{m.managers.map(slug => cast.find(c => c.slug === slug)?.displayName || slug).join(' × ')}</p>}<div class="tags">{m.tags.map(t => <span>{t}</span>)}</div></figcaption></figure>)}</div>
  <p id="empty-results" hidden>No memes match those filters. Reset to bring the bench back.</p>
  <p class="small muted">New images require owner approval. If no new artwork is approved, a recap reuses approved evergreen artwork or a portrait. No AI scene-generation service is configured.</p>
  <noscript><p>Filtering needs JavaScript. All memes remain visible without it.</p></noscript>
</Layout>
<script>
const search = document.querySelector('#meme-search');
const tag = document.querySelector('#tag-filter');
const managers = [...document.querySelectorAll('input[name="manager"]')];
const cards = [...document.querySelectorAll('.meme')];
function filter() {
  const q = search.value.trim().toLowerCase();
  const selected = managers.filter(m => m.checked).map(m => m.value);
  let count = 0;
  for (const card of cards) {
    const tags = JSON.parse(card.dataset.tags || '[]');
    const people = JSON.parse(card.dataset.managers || '[]');
    const show = (card.dataset.caption || '').includes(q) && (!tag.value || tags.includes(tag.value)) && (!selected.length || selected.some(m => people.includes(m)));
    card.hidden = !show;
    if (show) count++;
  }
  document.querySelector('#results').textContent = `Showing ${count} of ${cards.length} memes`;
  document.querySelector('#empty-results').hidden = count !== 0;
}
search.addEventListener('input', filter);
tag.addEventListener('change', filter);
for (const manager of managers) manager.addEventListener('change', filter);
document.querySelector('#clear-filters').addEventListener('click', () => {
  search.value = ''; tag.value = '';
  for (const manager of managers) manager.checked = false;
  filter(); search.focus();
});
</script>
