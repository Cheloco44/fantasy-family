---
import Layout from '../layouts/Layout.astro';
import data from '../data/clubhouse.json';
import CurrentLeague from '../components/CurrentLeague.astro';
import DataStatus from '../components/DataStatus.astro';
const base = import.meta.env.BASE_URL;
const featured = data.memes.find(m=>m.featured);
---
<Layout title="Clubhouse" active="home"><div class="dashboard"><div><CurrentLeague /><section class="lead" style="margin-top:32px" aria-labelledby="headline"><span class="pill">THE MORNING SKATE / SAMPLE EDITION</span><div class="eyebrow">Daily recap / style preview</div><h2 id="headline">The bench would<br/>like a word.</h2><p>A sample of the morning broadcast: questionable lineup decisions, original chirps, and a healthy respect for the receipts. No actual league results are represented.</p><a class="btn" href={`${base}recaps/sample/`}>Read the sample edition <span aria-hidden="true">↗</span></a></section><section><div class="section-heading"><h2>Meet the management</h2><a href={`${base}managers/`}>All profiles →</a></div>{data.managers.map(m=><a class="mini-profile" href={`${base}managers/${m.slug}/`}><img class="avatar mini-portrait" src={`${base}${m.image}`} alt={`${m.alias} — owner-labeled portrait`} width="54" height="54" loading="lazy" /><span><strong>{m.alias}</strong><small>{m.team} · owner-supplied</small></span><span style="margin-left:auto" aria-hidden="true">↗</span></a>)}</section></div><aside class="sidebar"><DataStatus />{featured&&<section class="featured"><div class="eyebrow">FROM THE MEME LOCKER / DEMO</div><a href={`${base}memes/`}><img src={`${base}${featured.image}`} width="780" height="600" alt={featured.caption}/></a><p>{featured.caption}</p><a class="small" href={`${base}memes/`}>Browse the locker →</a></section>}</aside></div></Layout>
